#!/bin/ash
set -eu

apk add --no-cache e2fsprogs iproute2 iputils busybox-extras
# NETPROBE relies on BusyBox timeout as its non-bypassable upper bound.  Fail
# the controlled build rather than promote an image without that applet.
/bin/busybox timeout --help >/dev/null
adduser -D -H -u 1001 -s /bin/ash competitor
passwd -l competitor
install -d -m 0755 /usr/local/libexec
install -m 0755 /run/sandboxer-build/sandboxer-common /usr/local/libexec/sandboxer-common
install -m 0755 /run/sandboxer-build/sandboxer-mount-runtime /usr/local/libexec/sandboxer-mount-runtime
install -m 0755 /run/sandboxer-build/sandboxer-setup /usr/local/libexec/sandboxer-setup
install -m 0755 /run/sandboxer-build/sandboxer-toy /usr/local/libexec/sandboxer-toy
install -m 0755 /run/sandboxer-build/sandboxer-service.cgi /usr/local/libexec/sandboxer-service.cgi
install -m 0755 /run/sandboxer-build/sandboxer-control /usr/local/libexec/sandboxer-control
install -m 0755 /run/sandboxer-build/sandboxer-runner.init /etc/init.d/sandboxer-runner
mkdir -p /workspace
chown competitor:competitor /workspace
chmod 0700 /workspace
# OpenRC needs mutable state even though the runtime root disk is read-only.
# These mounts are runtime RAM state, never a host mount or Runner workspace.
sed -i '1i::sysinit:/usr/local/libexec/sandboxer-mount-runtime' /etc/inittab
touch /etc/cloud/cloud-init.disabled
# The generic cloud image registers OpenRC's DHCP networking unit in the
# default runlevel. It starts after our sysinit handler and could put a
# default route back on eth0. Runtime setup alone owns the static Arena
# address, so fail the image build unless that late network configurator is
# absent.
rc-update del networking default
test ! -e /etc/runlevels/default/networking || { printf 'SANDBOXER_NETWORKING_SERVICE_REMAINS\n' > /dev/ttyS0; exit 1; }
# The marker disables most cloud-init stages, but hotplugd itself has no
# marker guard. Remove every cloud-init service link and the inherited DHCP
# interface declaration, so no post-sysinit process can recreate a route.
rc-update del cloud-init-local boot
rc-update del cloud-init-hotplugd default
for service in cloud-init cloud-config cloud-final; do
    rc-update del "$service" default
done
test ! -e /etc/runlevels/boot/cloud-init-local || { printf 'SANDBOXER_CLOUD_INIT_SERVICE_REMAINS\n' > /dev/ttyS0; exit 1; }
for service in cloud-init cloud-config cloud-final cloud-init-hotplugd; do
    test ! -e "/etc/runlevels/default/$service" || { printf 'SANDBOXER_CLOUD_INIT_SERVICE_REMAINS\n' > /dev/ttyS0; exit 1; }
done
test ! -e /etc/runlevels/default/cloud-init-hotplugd || { printf 'SANDBOXER_CLOUD_INIT_SERVICE_REMAINS\n' > /dev/ttyS0; exit 1; }
printf '%s\n' 'auto lo' 'iface lo inet loopback' > /etc/network/interfaces
# The cloud build's user-data may install an authorized key and leaves its
# seed/instance state behind.  None of that is a valid part of a Runner base.
# Remove every credential-bearing category before the success marker; the
# runtime control probe independently repeats this check after boot.
rm -rf /root/.ssh /root/.aws /root/.config/gcloud
rm -rf /home/competitor/.ssh /home/competitor/.aws /home/competitor/.config/gcloud
rm -rf /var/lib/cloud /run/sandboxer-build
for path in /root/.ssh /root/.aws /root/.config/gcloud /home/competitor/.ssh /home/competitor/.aws /home/competitor/.config/gcloud /var/lib/cloud /run/sandboxer-build; do
    test ! -e "$path" || { printf 'SANDBOXER_BUILD_SANITIZATION_FAILED\n' > /dev/ttyS0; exit 1; }
done
apk info -vv | sort > /etc/sandboxer-image-packages.txt
printf 'SANDBOXER_BUILD_OK\n' > /dev/ttyS0
sync
# The promoted image must not need ext4 journal recovery at runtime, because
# the Runner attaches its root disk read-only. This is deliberately graceful.
poweroff
