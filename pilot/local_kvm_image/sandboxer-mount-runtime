#!/bin/ash
# OpenRC itself needs mutable run-state before it can process the default
# runlevel. This runs from Alpine inittab immediately after the read-only root
# is mounted and before OpenRC starts.
. /usr/local/libexec/sandboxer-common
printf 'SANDBOXER_RUNTIME_BOOTSTRAP\n' > /dev/ttyS0
mountpoint -q /run || mount -t tmpfs -o rw,nosuid,nodev,mode=0755 tmpfs /run
mountpoint -q /tmp || mount -t tmpfs -o rw,nosuid,nodev,noexec,mode=1777 tmpfs /tmp
printf 'SANDBOXER_RUNTIME_MOUNTS_READY\n' > /dev/ttyS0
route_marker() {
    state="$(sandboxer_route_state)" || { printf 'SANDBOXER_ROUTE_MARKER_UNAVAILABLE\n' > /dev/ttyS0; return; }
    case "$state" in
        absent) printf 'SANDBOXER_ROUTE_ABSENT_%s\n' "$1" > /dev/ttyS0 ;;
        present) printf 'SANDBOXER_ROUTE_PRESENT_%s\n' "$1" > /dev/ttyS0 ;;
        *) printf 'SANDBOXER_ROUTE_MARKER_UNAVAILABLE\n' > /dev/ttyS0 ;;
    esac
}
printf 'SANDBOXER_STAGE_SETUP\n' > /dev/ttyS0
/usr/local/libexec/sandboxer-setup > /dev/ttyS0 2>&1 || { printf 'SANDBOXER_SETUP_FAILED\n' > /dev/ttyS0; exit 1; }
route_marker AFTER_SETUP
printf 'SANDBOXER_STAGE_TOY\n' > /dev/ttyS0
toy_outcome() {
    printf '%s\n' "$1" > /run/sandboxer-toy-bootstrap-state
    case "$1" in
        root_failed) printf 'SANDBOXER_TOY_ROOT_FAILED\n' > /dev/ttyS0 ;;
        exec_failed) printf 'SANDBOXER_TOY_EXEC_FAILED\n' > /dev/ttyS0 ;;
        address_unavailable) printf 'SANDBOXER_TOY_ADDRESS_UNAVAILABLE\n' > /dev/ttyS0 ;;
        httpd_bind_exit) printf 'SANDBOXER_TOY_HTTPD_BIND_EXIT\n' > /dev/ttyS0 ;;
        exited_other) printf 'SANDBOXER_TOY_EXITED_OTHER\n' > /dev/ttyS0 ;;
        ready) printf 'SANDBOXER_TOY_READY\n' > /dev/ttyS0 ;;
        *) printf 'SANDBOXER_TOY_EXITED_OTHER\n' > /dev/ttyS0 ;;
    esac
}
if ! test -r /workspace/notes/index.html; then
    toy_outcome root_failed
    exit 1
fi
if ! sandboxer_load_metadata || ! sandboxer_local_address_ready "$SANDBOXER_IP"; then
    toy_outcome address_unavailable
    exit 1
fi
start-stop-daemon --start --background --make-pidfile --pidfile /run/sandboxer-toy.pid \
    --chdir /workspace/notes --chuid competitor --exec /usr/sbin/httpd -- \
    -f -p 8080 -h /workspace/notes >/dev/null 2>&1 || {
    toy_outcome exec_failed
    exit 1
}
if ! test -s /run/sandboxer-toy.pid || ! kill -0 "$(cat /run/sandboxer-toy.pid)" 2>/dev/null; then
    toy_outcome exec_failed
else
    if ! sandboxer_load_metadata; then
        toy_outcome exec_failed
    # Bootstrap health proves the local HTTP process through loopback. Arena
    # reachability on the declared address is independently measured by the
    # Blue/Red NETPROBE witnesses and must not be conflated with process health.
    elif sandboxer_toy_http_ready 127.0.0.1; then
        toy_outcome ready
    else
        toy_pid="$(cat /run/sandboxer-toy.pid)"
        process_outcome="$(cat /run/sandboxer-toy-process-outcome 2>/dev/null || printf unknown)"
        case "$process_outcome" in
            root_failed|exec_failed|address_unavailable|httpd_bind_exit|exited_other) toy_outcome "$process_outcome" ;;
            *)
                toy_process_state="$(awk '{print $3}' /proc/"$toy_pid"/stat 2>/dev/null || printf unknown)"
                case "$toy_process_state" in
                    Z) toy_outcome exited_other ;;
                    unknown) toy_outcome exited_other ;;
                    *) toy_outcome httpd_bind_exit ;;
                esac
                ;;
        esac
    fi
fi
route_marker AFTER_TOY
printf 'SANDBOXER_STAGE_CONTROL\n' > /dev/ttyS0
route_marker BEFORE_CONTROL
start-stop-daemon --start --background --make-pidfile --pidfile /run/sandboxer-control.pid --exec /usr/local/libexec/sandboxer-control || {
    printf 'SANDBOXER_CONTROL_FAILED\n' > /dev/ttyS0
    exit 1
}
printf 'SANDBOXER_RUNTIME_READY\n' > /dev/ttyS0
