#!/sbin/openrc-run

description="Sandboxer immutable Runner setup, toy service, and control channel"

depend() {
    need localmount
    after bootmisc
    before net
}

start() {
    ebegin "Starting Sandboxer Runner"
    /usr/local/libexec/sandboxer-setup || return 1
    start-stop-daemon --start --background --make-pidfile --pidfile /run/sandboxer-toy.pid --exec /usr/local/libexec/sandboxer-toy || return 1
    start-stop-daemon --start --background --make-pidfile --pidfile /run/sandboxer-control.pid --exec /usr/local/libexec/sandboxer-control || return 1
    eend 0
}

stop() {
    start-stop-daemon --stop --pidfile /run/sandboxer-control.pid --retry TERM/5/KILL/5 || true
    start-stop-daemon --stop --pidfile /run/sandboxer-toy.pid --retry TERM/5/KILL/5 || true
}
