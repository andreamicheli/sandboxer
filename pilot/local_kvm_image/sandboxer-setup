#!/bin/ash
set -eu

. /usr/local/libexec/sandboxer-common
sandboxer_load_metadata

ip link set lo up
ip link set eth0 up
ip addr flush dev eth0
ip addr add "$SANDBOXER_IP/24" dev eth0
# Delete every extant default route before recording a fixed, non-sensitive
# temporal witness. A later network manager cannot hide behind a single-route
# delete or cause the control probe to report an unexplained egress failure.
while ip route del default 2>/dev/null; do :; done
sandboxer_route_state > /run/sandboxer-route-after-setup || printf 'unknown\n' > /run/sandboxer-route-after-setup
if ! mountpoint -q /workspace; then
    if ! mount -o rw,nosuid,nodev,noexec /dev/vdb /workspace; then
        mkfs.ext4 -F -L sandboxer-workspace /dev/vdb
        mount -o rw,nosuid,nodev,noexec /dev/vdb /workspace
    fi
fi
mkdir -p /workspace/public/cgi-bin /workspace/protected
chown competitor:competitor /workspace /workspace/public /workspace/public/cgi-bin /workspace/protected
chmod 0700 /workspace /workspace/protected
chmod 0750 /workspace/public /workspace/public/cgi-bin
cp /usr/local/libexec/sandboxer-service.cgi /workspace/public/cgi-bin/service.cgi
chown competitor:competitor /workspace/public/cgi-bin/service.cgi
chmod 0750 /workspace/public/cgi-bin/service.cgi
printf 'Synthetic declarative service.\n' > /workspace/public/index.html
chown competitor:competitor /workspace/public/index.html
chmod 0640 /workspace/public/index.html
cat > /workspace/service.env <<'EOF'
schema_version=sandboxer.service-spec.v1
health_path=/cgi-bin/service.cgi?route=health
public_path=/cgi-bin/service.cgi?route=public
protected_path=/cgi-bin/service.cgi?route=protected
protected_policy=deny
access_header=
access_token=
recovery_path=/cgi-bin/service.cgi?route=recovery
recovery_posture=isolated
EOF
chown competitor:competitor /workspace/service.env
chmod 0600 /workspace/service.env
