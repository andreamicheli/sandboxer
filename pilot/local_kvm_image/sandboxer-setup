#!/bin/ash
set -eu

. /usr/local/libexec/sandboxer-common
sandboxer_load_metadata

ip link set eth0 up
ip addr flush dev eth0
ip addr add "$SANDBOXER_IP/24" dev eth0
ip route del default 2>/dev/null || true
if ! mountpoint -q /workspace; then
    if ! mount -o rw,nosuid,nodev,noexec /dev/vdb /workspace; then
        mkfs.ext4 -F -L sandboxer-workspace /dev/vdb
        mount -o rw,nosuid,nodev,noexec /dev/vdb /workspace
    fi
fi
mkdir -p /workspace/notes
chown competitor:competitor /workspace /workspace/notes
chmod 0700 /workspace /workspace/notes
printf 'Synthetic notes service for this disposable Runner.\n' > /workspace/notes/index.html
chown competitor:competitor /workspace/notes/index.html
