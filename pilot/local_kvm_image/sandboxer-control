#!/bin/ash
set -eu

. /usr/local/libexec/sandboxer-common
PORT=/dev/virtio-ports/org.sandboxer.control
route_at_control=unknown
route_origin=unknown
dhcp_client=unknown

probe_bool() {
    if "$1"; then printf 1; else printf 0; fi
}

tcp_http() {
    # wget has an application timeout, and BusyBox timeout is the independent
    # hard bound if DNS/TCP teardown ever fails to honour it.
    /bin/busybox timeout -s KILL 3 /bin/busybox wget -q -T 2 -O /dev/null "http://$1:$2/"
}

tcp_connect() {
    # A zero-byte stdin performs only the TCP connect attempt.  Pair its own
    # deadline with timeout's hard kill so every negative witness remains
    # finite even when neighbour discovery stalls.
    /bin/busybox timeout -s KILL 1 /bin/busybox nc -w 1 "$1" "$2" </dev/null >/dev/null 2>&1
}

icmp_probe() {
    /bin/busybox timeout -s KILL 2 ping -c 1 -W 1 "$1" >/dev/null 2>&1
}

network_stage() {
    # Fixed labels only: serial evidence locates a stalled witness without
    # disclosing addresses, requests, service contents, or the nonce.
    printf 'SANDBOXER_NETPROBE_STAGE=%s\n' "$1" >> /dev/ttyS0 2>/dev/null || true
}

network_proof() {
    phase="$1"
    # Every subprocess has its own hard bound.  The Red path is at most twelve
    # seconds of guest work; the host deadline is deliberately twice that bound
    # so scheduling and virtio delivery cannot erase an already-produced proof.
    network_stage start
    peer_denied=0
    toy_http=0
    local_toy=0
    network_stage local_toy
    tcp_http "$SANDBOXER_IP" 8080 && local_toy=1
    network_stage peer
    peer_tcp=0
    if test "$phase" = blue; then
        tcp_connect "$SANDBOXER_PEER_IP" 8080 || peer_denied=1
    else
        if tcp_connect "$SANDBOXER_PEER_IP" 8080; then
            peer_tcp=1
            tcp_http "$SANDBOXER_PEER_IP" 8080 && toy_http=1
        fi
    fi
    alternate_denied=0
    network_stage alternate
    tcp_connect "$SANDBOXER_PEER_IP" 8081 || alternate_denied=1
    icmp_denied=0
    network_stage icmp
    icmp_probe "$SANDBOXER_PEER_IP" || icmp_denied=1
    egress_denied=0
    network_stage egress
    if tcp_connect 198.51.100.1 81; then
        egress_reason=tcp_reachable
    else
        egress_denied=1
        egress_reason=blocked
    fi
    orchestrator_denied=0
    network_stage orchestrator
    tcp_connect 10.77.0.1 1 || orchestrator_denied=1
    network_stage emit
    printf 'SANDBOXER_NETPROBE_RESULT phase=%s peer_denied=%s peer_tcp=%s toy_http=%s alternate_denied=%s icmp_denied=%s egress_denied=%s egress_reason=%s orchestrator_denied=%s local_toy=%s\n' \
        "$phase" "$peer_denied" "$peer_tcp" "$toy_http" "$alternate_denied" "$icmp_denied" "$egress_denied" "$egress_reason" "$orchestrator_denied" "$local_toy" >> /dev/ttyS0 2>/dev/null || true
    printf 'NETWORK_PROBE nonce=%s phase=%s peer_denied=%s peer_tcp=%s toy_http=%s alternate_denied=%s icmp_denied=%s egress_denied=%s egress_reason=%s orchestrator_denied=%s local_toy=%s\n' \
        "$SANDBOXER_NONCE" "$phase" "$peer_denied" "$peer_tcp" "$toy_http" "$alternate_denied" "$icmp_denied" "$egress_denied" "$egress_reason" "$orchestrator_denied" "$local_toy"
    network_stage emitted
}

while :; do
    sandboxer_load_metadata || { sleep 1; continue; }
    # Compute the temporal control-start witness before accepting requests.
    # The first PROBE must only read fixed local markers, never invoke ip.
    # Persist one coherent route snapshot and emit its serial labels once so
    # they cannot displace useful bootstrap evidence from the bounded tail.
    if ! test -e /run/sandboxer-control-diagnostics-emitted; then
        route_diagnostics="$(sandboxer_route_diagnostics)" || route_diagnostics='unknown unknown'
        set -- $route_diagnostics
        if test "$#" -eq 2; then
            route_at_control="$1"
            route_origin="$2"
        else
            route_at_control=unknown
            route_origin=unknown
        fi
        case "$route_at_control:$route_origin" in
            absent:absent|present:dhcp|present:ra|present:static|present:other) ;;
            *) route_at_control=unknown; route_origin=unknown ;;
        esac
        printf '%s\n' "$route_at_control" > /run/sandboxer-route-at-control
        printf '%s\n' "$route_origin" > /run/sandboxer-route-origin
        dhcp_client="$(sandboxer_dhcp_client_present)" || dhcp_client=unknown
        case "$dhcp_client" in 0|1|unknown) ;; *) dhcp_client=unknown;; esac
        printf '%s\n' "$dhcp_client" > /run/sandboxer-dhcp-client
        case "$route_origin" in
            absent|dhcp|ra|static|other) printf 'SANDBOXER_ROUTE_ORIGIN_%s\n' "$(printf '%s' "$route_origin" | tr a-z A-Z)" >> /dev/ttyS0 2>/dev/null || true ;;
            *) printf 'SANDBOXER_ROUTE_ORIGIN_UNKNOWN\n' >> /dev/ttyS0 2>/dev/null || true ;;
        esac
        case "$dhcp_client" in 0|1) printf 'SANDBOXER_DHCP_CLIENT_%s\n' "$dhcp_client" >> /dev/ttyS0 2>/dev/null || true;; *) printf 'SANDBOXER_DHCP_CLIENT_UNKNOWN\n' >> /dev/ttyS0 2>/dev/null || true;; esac
        : > /run/sandboxer-control-diagnostics-emitted
    fi
    exec 3<> "$PORT"
    if IFS= read -r command <&3; then
        set -- $command
        if test "$1" = PROBE && test "${2:-}" = "$SANDBOXER_NONCE" && test "$#" -eq 2; then
            toy_bootstrap="$(cat /run/sandboxer-toy-bootstrap-state 2>/dev/null || printf unknown)"
            case "$toy_bootstrap" in
                ready|root_failed|exec_failed|address_unavailable|httpd_bind_exit|exited_other|unknown|root_missing|launch_failed|listener_missing) ;;
                *) toy_bootstrap=unknown;;
            esac
            printf 'READY nonce=%s uid=%s boot_id=%s no_credentials=%s private_mounts=%s route_after_setup=%s route_at_control=%s route_origin=%s dhcp_client=%s toy_bootstrap=%s\n' \
                "$SANDBOXER_NONCE" "$(id -u competitor)" "$(cat /proc/sys/kernel/random/boot_id)" \
                "$(probe_bool sandboxer_no_credentials)" "$(probe_bool sandboxer_private_mounts)" \
                "$(cat /run/sandboxer-route-after-setup 2>/dev/null || printf unknown)" \
                "$(cat /run/sandboxer-route-at-control 2>/dev/null || { printf 'SANDBOXER_ROUTE_MARKER_UNAVAILABLE\n' >> /dev/ttyS0 2>/dev/null || true; printf unknown; })" \
                "$route_origin" "$dhcp_client" "$toy_bootstrap" >&3
            printf 'PROBE_OK nonce=%s uid=%s clock_epoch=%s\n' "$SANDBOXER_NONCE" "$(id -u competitor)" "$(date +%s)" >&3
        elif test "$1" = NETPROBE && test "${2:-}" = "$SANDBOXER_NONCE" && { test "${3:-}" = blue || test "${3:-}" = red; } && test "$#" -eq 3; then
            network_proof "$3" >&3
        elif test "$1" = PHASE_RED && test "${2:-}" = "$SANDBOXER_NONCE" && test "$#" -eq 2; then
            if /bin/busybox timeout -s KILL 2 /sbin/ip neigh flush dev eth0 >/dev/null 2>&1; then
                printf 'PHASE_RED_OK nonce=%s\n' "$SANDBOXER_NONCE" >&3
            else
                printf 'PHASE_RED_FAILED nonce=%s\n' "$SANDBOXER_NONCE" >&3
            fi
        fi
    fi
    exec 3>&-
    exec 3<&-
done
