#!/bin/sh
set -eu

if [ -f /arena/runtime/service.pid ]; then
  old_pid=$(cat /arena/runtime/service.pid)
  kill "$old_pid" 2>/dev/null || true
fi

mkdir -p /arena/service /arena/runtime /arena/logs /arena/submissions
find /arena/service -mindepth 1 -delete
find /arena/runtime -mindepth 1 -delete
find /arena/logs -mindepth 1 -delete
find /arena/submissions -mindepth 1 -delete
find /arena -maxdepth 1 -type f -name 'flag.txt' -delete
cp -R /opt/pristine/. /arena/service/
arena-restart
echo "arena reset"
