[TEMPLATE]
GROQ_API_KEY=
SANDBOXER_ALPHA_MODEL=
SANDBOXER_BETA_MODEL=

# Broadcast layer — control-plane only, never copied into a Runner.
# Fill these with: python scripts/setup_credentials.py gemini --key <key> --probe
#   and  python scripts/setup_credentials.py youtube --client-id <id> --client-secret <secret>
# Gemini TTS (AI Studio API key, https://aistudio.google.com/apikey); the model
# is pinned by the editorial manifest.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Approved fallback chain, comma-separated, tried in order when the primary's
# free-tier quota window is exhausted.  Defaults to the Gemini 2.5 Flash TTS
# preview; 2.5 Pro preview has no free-tier quota and is only useful on a paid
# tier.  Fallback is only used when SANDBOXER_TTS_ALLOW_FALLBACK is truthy, and
# the model actually used is recorded per block (models_used) — never silent.
#GEMINI_TTS_FALLBACK_MODELS=gemini-2.5-flash-preview-tts,gemini-2.5-pro-preview-tts
#SANDBOXER_TTS_ALLOW_FALLBACK=1

# Default TTS provider for render_commentary_audio.py.  Set to "fish" to make
# Fish Audio the primary (Gemini stays available via --provider gemini).
#SANDBOXER_TTS_PROVIDER=gemini

# Fish Audio TTS (https://fish.audio) — free developer tier: the s2.1-pro-free
# model has no hard usage cap under Fair Use.  Select it with
#   python scripts/render_commentary_audio.py --provider fish
# (or --tts fish in publish_broadcast.py).
FISH_API_KEY=
#FISH_TTS_MODEL=s2.1-pro-free
# Logical voice -> Fish voice-model reference_id pairs (comma-separated). The
# logical names must match the role voices (Kore=play-by-play, Charon=analyst);
# get reference_ids from the Fish voice library.
#FISH_TTS_VOICES=Kore=<ref>,Charon=<ref>

# YouTube Data API v3 OAuth 2.0 (Desktop-app client + refresh token).
# Create the client in Google Cloud Console > APIs & Services > OAuth client ID
# (type: Desktop app), enable YouTube Data API v3, then run the login above.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
