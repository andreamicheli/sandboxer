[TEMPLATE]
GROQ_API_KEY=
SANDBOXER_ALPHA_MODEL=
SANDBOXER_BETA_MODEL=

# Broadcast layer — control-plane only, never copied into a Runner.
# Fill these with: python scripts/setup_credentials.py gemini --key <key> --probe
#   and  python scripts/setup_credentials.py youtube --client-id <id> --client-secret <secret>
# Gemini TTS (AI Studio API key, https://aistudio.google.com/apikey); the model
# is pinned by the editorial manifest.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# YouTube Data API v3 OAuth 2.0 (Desktop-app client + refresh token).
# Create the client in Google Cloud Console > APIs & Services > OAuth client ID
# (type: Desktop app), enable YouTube Data API v3, then run the login above.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
