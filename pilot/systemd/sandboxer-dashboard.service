[Unit]
Description=SandBoxer private operator dashboard
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/SandBoxer/pilot
ExecStart=/home/ubuntu/projects/SandBoxer/pilot/.venv/bin/python -m scripts.serve_dashboard --host 127.0.0.1 --port 8765 --projection /var/lib/sandboxer/dashboard/projection.json --published-root /var/lib/sandboxer/dashboard/published --audit-path /var/lib/sandboxer/dashboard/audit.jsonl --token-file /var/lib/sandboxer/dashboard/operator.token
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/sandboxer/dashboard

[Install]
WantedBy=multi-user.target
